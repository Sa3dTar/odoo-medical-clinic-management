<odoo>
    <record id="view_medical_doctor_commission_form" model="ir.ui.view">
        <field name="name">medical.doctor.commission.form</field>
        <field name="model">medical.doctor.commission</field>
        <field name="arch" type="xml">
            <form string="Doctor Commission">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="doctor_id" widget="many2one_avatar_user"/>
                            <field name="appointment_id"/>
                            <field name="invoice_id"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                            <field name="commission_percentage"/>
                            <field name="commission_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medical_doctor_commission_tree" model="ir.ui.view">
        <field name="name">medical.doctor.commission.list</field>
        <field name="model">medical.doctor.commission</field>
        <field name="arch" type="xml">
            <list string="Doctor Commissions">
                <field name="doctor_id"/>
                <field name="appointment_id"/>
                <field name="total_amount"/>
                <field name="commission_percentage"/>
                <field name="commission_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_medical_doctor_commission" model="ir.actions.act_window">
        <field name="name">Doctor Commissions</field>
        <field name="res_model">medical.doctor.commission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>