<odoo>
    <record id="view_medical_record_form" model="ir.ui.view">
        <field name="name">medical.record.form</field>
        <field name="model">medical.record</field>
        <field name="arch" type="xml">
            <form string="Medical Record">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id" widget="many2one_avatar"/>
                            <field name="doctor_id" widget="many2one_avatar_user"/>
                            <field name="appointment_id"/>
                        </group>
                        <group>
                            <field name="visit_date"/>
                            <field name="blood_pressure"/>
                            <field name="heart_rate"/>
                            <field name="temperature"/>
                            <field name="weight"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diagnosis &amp; Notes">
                            <field name="diagnosis" placeholder="Enter clinical diagnosis and notes here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medical_record_tree" model="ir.ui.view">
        <field name="name">medical.record.list</field>
        <field name="model">medical.record</field>
        <field name="arch" type="xml">
            <list string="Medical Records">
                <field name="visit_date"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="diagnosis"/>
            </list>
        </field>
    </record>

    <record id="action_medical_record" model="ir.actions.act_window">
        <field name="name">Medical Records</field>
        <field name="res_model">medical.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>