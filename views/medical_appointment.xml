<odoo>
    <!-- 1. Form View -->
    <record id="view_medical_appointment_form" model="ir.ui.view">
        <field name="name">medical.appointment.form</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <form string="Medical Appointment">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_consultation,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" widget="many2one_avatar"/>
                            <field name="doctor_id" widget="many2one_avatar_user"/>
                            <field name="appointment_date"/>
                        </group>
                        <group>
                            <field name="consultation_fee"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="prescription_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- 2. List (Tree) View - Fixed for Odoo 18 -->
    <record id="view_medical_appointment_list" model="ir.ui.view">
        <field name="name">medical.appointment.list</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <list string="Medical Appointments" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="consultation_fee"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- 3. Action -->
    <record id="action_medical_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">medical.appointment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>