<odoo>
    <record id="view_medical_prescription_form" model="ir.ui.view">
        <field name="name">medical.prescription.form</field>
        <field name="model">medical.prescription</field>
        <field name="arch" type="xml">
            <form string="Medical Prescription">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" widget="many2one_avatar"/>
                            <field name="doctor_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="appointment_id"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prescribed Medicines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="medicine_name"/>
                                    <field name="dose"/>
                                    <field name="frequency"/>
                                    <field name="duration"/>
                                    <field name="instructions"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medical_prescription_tree" model="ir.ui.view">
        <field name="name">medical.prescription.list</field>
        <field name="model">medical.prescription</field>
        <field name="arch" type="xml">
            <list string="Prescriptions">
                <field name="name"/>
                <field name="date"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
            </list>
        </field>
    </record>

    <record id="action_medical_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">medical.prescription</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>